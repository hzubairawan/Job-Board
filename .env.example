# Copy this file to ".env" and fill in real values. NEVER commit ".env".

# "development" or "production"
APP_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Optional. Defaults to instance/app.db (SQLite).
# DATABASE_URL=sqlite:////absolute/path/to/app.db

# Optional. Defaults to ./uploads (kept outside /static, never served directly).
# UPLOAD_FOLDER=/absolute/path/to/uploads

# Used by "flask create-admin" when options are not passed on the command line.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional AI features (Claude API). Leave blank to use the built-in local fallback.
# Resume text is sent to Anthropic's API ONLY when a key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_CALLS_PER_HOUR=30
